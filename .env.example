# HuggingFace Token (for pyannote.audio diarization in mmt.py)
HF_TOKEN=your_huggingface_token_here

# LLM Summarization Configuration
# API endpoint for OpenAI-compatible LLM service (e.g., OpenRouter, local llama.cpp server)
# The system validates known providers and will warn/substitute if endpoint is incorrect
# Examples of correct endpoints:
#   - https://openrouter.ai/api/v1/chat/completions
#   - https://api.openai.com/v1/chat/completions
#   - http://localhost:8080/v1/chat/completions (llama.cpp)
#   - http://localhost:11434/v1/chat/completions (Ollama)
# Use --no-confirm flag to auto-substitute malformed endpoints for known providers
LLM_API_ENDPOINT=https://openrouter.ai/api/v1/chat/completions

# API key for the LLM service
LLM_API_KEY=your_openrouter_api_key_here

# Model architecture to use for summarization, API provider tag
# Recommended: nvidia/nemotron-3-super-120b-a12b:free (free tier on OpenRouter)
LLM_MODEL_ARCH=nvidia/nemotron-3-super-120b-a12b:free

# Model to use for token counting, huggingface tag (may differ from API)
# (must be the same model as LLM_MODEL_ARCH for accurate results)
# e.g. nvidia/NVIDIA-Nemotron-3-Super-120B-A12B-BF16
# closed-source models may need to be approximated with other model tokenizers.
LLM_TOKENIZER_MODEL=nvidia/NVIDIA-Nemotron-3-Super-120B-A12B-BF16