# HuggingFace Token (for pyannote.audio diarization in mmt.py)
HF_TOKEN=your_huggingface_token_here

# LLM Summarization Configuration
# API endpoint for OpenAI-compatible LLM service (e.g., OpenRouter, local llama.cpp server)
LLM_API_ENDPOINT=https://openrouter.ai/api/v1

# API key for the LLM service
LLM_API_KEY=your_openrouter_api_key_here

# Model architecture to use for summarization
# Recommended: nvidia/nemotron-3-super-120b-a12b:free (free tier on OpenRouter)
LLM_MODEL_ARCH=nvidia/nemotron-3-super-120b-a12b:free

# Model to use for token counting (can be same as LLM_MODEL_ARCH or different)
LLM_TOKENIZER_MODEL=nvidia/NVIDIA-Nemotron-3-Super-120B-A12B-BF16